<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OTH.CustomCosmetics</AssemblyName>
    <RootNamespace>OverTheHillPlus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\OTH.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One folder per part under Liveries/cosmetics/<part_id>/ (the contract is Liveries/cosmetics/FORMAT.md): its part.json,
         mesh and textures become the resources cosmetics/<part_id>/<file>, read by PartLibrary. Dropping a folder in is all
         a new part needs; renders, credits and sources stay out of the DLL. -->
    <EmbeddedResource Include="..\..\..\Liveries\cosmetics\*\part.json;..\..\..\Liveries\cosmetics\*\*.mesh;..\..\..\Liveries\cosmetics\*\albedo.png;..\..\..\Liveries\cosmetics\*\mask.png;..\..\..\Liveries\cosmetics\*\lights.png;..\..\..\Liveries\cosmetics\*\ao.png;..\..\..\Liveries\cosmetics\*\icon.png"
                      LogicalName="cosmetics/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
