<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OTH.Drover</AssemblyName>
    <RootNamespace>OverTheHillPlus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\OTH.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model (drover.mesh, with body_lod1..3) and its textures, made by Liveries/tools/drover/build_drover.py with
         the shared exporter (Liveries/drover/), read by core's car framework (CarAssets). -->
    <EmbeddedResource Include="Assets\*.mesh;Assets\*.png" Exclude="Assets\card.png" LogicalName="drover/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
