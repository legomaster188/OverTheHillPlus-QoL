<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OTH.Marten</AssemblyName>
    <!-- Also built for MelonLoader (src/MelonCarPack.slnf, -p:Loader=Melon); its MelonMod is this class. -->
    <OthMelon>true</OthMelon>
    <OthPluginClass>OverTheHillPlus.Marten.MartenPlugin</OthPluginClass>
    <RootNamespace>OverTheHillPlus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\OTH.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model (marten.mesh, with body_lod1..3) and its textures, made by Liveries/tools/marten/build_marten.py with
         the shared exporter (Liveries/marten/), read by core's car framework (CarAssets). -->
    <EmbeddedResource Include="Assets\*.mesh;Assets\*.png" Exclude="Assets\card.png" LogicalName="marten/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
