<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OTH.Bento</AssemblyName>
    <RootNamespace>OverTheHillPlus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\OTH.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model (bento.mesh, with body_lod1..3) and its textures, made by Liveries/tools/bento/build_bento.py with
         the shared exporter (Liveries/bento/), read by core's car framework (CarAssets). -->
    <EmbeddedResource Include="Assets\*.mesh;Assets\*.png" Exclude="Assets\card.png" LogicalName="bento/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
