<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OTH.Unreleased</AssemblyName>
    <!-- Also built for MelonLoader (src/MelonCarPack.slnf, -p:Loader=Melon); its MelonMod is this class. -->
    <OthMelon>true</OthMelon>
    <OthPluginClass>OverTheHillPlus.Unreleased.UnreleasedPlugin</OthPluginClass>
    <RootNamespace>OverTheHillPlus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\OTH.Core.csproj" />
  </ItemGroup>

  <!-- The Brigand's and Cordillera's pictures (the game has none for them): Liveries/tools/vera/render_picture.py. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\*_picture.png" LogicalName="unreleased/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
