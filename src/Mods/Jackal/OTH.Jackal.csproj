<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OTH.Jackal</AssemblyName>
    <!-- Also built for MelonLoader (src/MelonFullPack.slnf, -p:Loader=Melon); its MelonMod is this class. -->
    <OthMelon>true</OthMelon>
    <OthPluginClass>OverTheHillPlus.Jackal.JackalPlugin</OthPluginClass>
    <RootNamespace>OverTheHillPlus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\OTH.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model (jackal.mesh, with body_lod1..3 and the moving parts) and its textures, made by
         Liveries/tools/jackal/build_jackal.py with the shared exporter (Liveries/jackal/), read by core's car framework. -->
    <EmbeddedResource Include="Assets\*.mesh;Assets\*.png" Exclude="Assets\card.png" LogicalName="jackal/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
