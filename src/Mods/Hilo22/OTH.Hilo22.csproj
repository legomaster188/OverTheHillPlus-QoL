<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OTH.Hilo22</AssemblyName>
    <RootNamespace>OverTheHillPlus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\OTH.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model (hilo22.mesh, with body_lod1..3) and its textures, made by Liveries/tools/hilo22/build_hilo22.py with
         the shared exporter (Liveries/hilo22/), read by core's car framework (CarAssets). -->
    <EmbeddedResource Include="Assets\*.mesh;Assets\*.png" Exclude="Assets\card.png" LogicalName="hilo22/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
