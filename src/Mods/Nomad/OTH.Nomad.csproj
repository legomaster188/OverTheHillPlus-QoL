<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OTH.Nomad</AssemblyName>
    <RootNamespace>OverTheHillPlus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\OTH.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model (nomad.mesh, with body_lod1..3) and its textures, made by Liveries/tools/nomad/build_nomad.py with
         the shared exporter (Liveries/nomad/), read by core's car framework (CarAssets). -->
    <EmbeddedResource Include="Assets\*.mesh;Assets\*.png" Exclude="Assets\card.png" LogicalName="nomad/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
