<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>OTH.Stoat</AssemblyName>
    <!-- Also built for MelonLoader (src/MelonFullPack.slnf, -p:Loader=Melon); its MelonMod is this class. -->
    <OthMelon>true</OthMelon>
    <OthPluginClass>OverTheHillPlus.Stoat.StoatPlugin</OthPluginClass>
    <RootNamespace>OverTheHillPlus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\OTH.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model (stoat.mesh, with body_lod1..3) and its textures, made by Liveries/tools/stoat/build_stoat.py with the shared
         exporter (Liveries/stoat/), read by core's car framework (CarAssets). -->
    <EmbeddedResource Include="Assets\*.mesh;Assets\*.png" Exclude="Assets\card.png" LogicalName="stoat/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
