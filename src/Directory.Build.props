<Project>
  <!-- Shared settings for every project in this folder. -->
  <PropertyGroup>
    <!-- BepInEx 6 IL2CPP and MelonLoader 0.7 both run mods on .NET 6 -->
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <Loader Condition="'$(Loader)' == ''">BepInEx</Loader>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\over the hill</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <!-- The real game: it runs MelonLoader now, and the Il2Cpp assemblies MelonLoader generates there follow every game
         update. A stale copy here built clean and then threw MissingMethodException in the game. -->
    <MelonGameDir Condition="'$(MelonGameDir)' == ''">$(GameDir) (MelonLoader)</MelonGameDir>
    <MelonDir>$(MelonGameDir)\MelonLoader</MelonDir>
    <!-- Projects that must not touch the game (the test project) set OthGameProject=false in their csproj. -->
    <OthGameProject Condition="'$(OthGameProject)' == ''">true</OthGameProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Loader)' == 'Melon'">
    <DefineConstants>$(DefineConstants);MELON</DefineConstants>
    <!-- Its own output folders, so both builds can sit side by side (obj\melon is inside obj, which the BepInEx build
         already leaves out of its sources). -->
    <BaseIntermediateOutputPath>obj\melon\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\melon\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <!-- A plugin class's static Harmony field hides MelonBase.Harmony (the melon's own instance): meant. -->
    <NoWarn>$(NoWarn);CS0108</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(OthGameProject)' == 'true' and '$(Loader)' != 'Melon'">
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <!-- Generated by BepInEx on first game launch -->
    <Reference Include="$(BepInExDir)\interop\*.dll" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(OthGameProject)' == 'true' and '$(Loader)' == 'Melon'">
    <!-- Under an extern alias: MelonLoader.dll also has a namespace called Harmony, which would hide HarmonyLib.Harmony. -->
    <Reference Include="$(MelonDir)\net6\MelonLoader.dll" Private="false" Aliases="melon" />
    <Reference Include="$(MelonDir)\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(MelonDir)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(MelonDir)\net6\Il2CppInterop.Common.dll" Private="false" />
    <!-- Generated by MelonLoader on first game launch (game namespaces get an Il2Cpp prefix: see MelonGlobalUsings.cs) -->
    <Reference Include="$(MelonDir)\Il2CppAssemblies\*.dll" Private="false" />
    <Compile Include="$(MSBuildThisFileDirectory)MelonGlobalUsings.cs" Link="MelonGlobalUsings.cs" />
  </ItemGroup>

  <!-- The MelonLoader attributes of each mod's DLL (written to obj, as MelonLoader.dll is referenced under an alias):
       the melon is the project's OthPluginClass, for this game (company and product from the game's app.info).
       HarmonyDontPatchAll: MelonLoader would otherwise apply every [HarmonyPatch] class itself, but the mods apply
       theirs through core (switched-off mods and features patch nothing). Core sets OthMelonPriority so MelonLoader
       starts it before every mod (lower starts first). -->
  <Target Name="OthMelonInfo" BeforeTargets="CoreCompile" Condition="'$(OthGameProject)' == 'true' and '$(Loader)' == 'Melon' and '$(OthPluginClass)' != ''">
    <PropertyGroup>
      <_OthMelonInfoFile>$(IntermediateOutputPath)OthMelonInfo.g.cs</_OthMelonInfoFile>
    </PropertyGroup>
    <ItemGroup>
      <_OthMelonInfoLine Include="extern alias melon%3B" />
      <_OthMelonInfoLine Include="[assembly: melon::MelonLoader.MelonInfo(typeof($(OthPluginClass)), $(OthPluginClass).Name, $(OthPluginClass).Version, &quot;Over the Hill Mods&quot;)]" />
      <_OthMelonInfoLine Include="[assembly: melon::MelonLoader.MelonGame(&quot;Funselektor&quot;, &quot;over the hill&quot;)]" />
      <_OthMelonInfoLine Include="[assembly: melon::MelonLoader.HarmonyDontPatchAll]" />
      <_OthMelonInfoLine Include="[assembly: melon::MelonLoader.MelonPriority($(OthMelonPriority))]" Condition="'$(OthMelonPriority)' != ''" />
    </ItemGroup>
    <WriteLinesToFile File="$(_OthMelonInfoFile)" Lines="@(_OthMelonInfoLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_OthMelonInfoFile)" />
      <FileWrites Include="$(_OthMelonInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- A mod's card in the MOD BROWSER (16:9 PNG, 640 x 360): Assets/card.png in the project's folder, embedded as
       "card.png"; core reads it from the DLL that registered the mod (UI/GameMenu/ModImages.cs). -->
  <ItemGroup Condition="'$(OthGameProject)' == 'true' and Exists('$(MSBuildProjectDirectory)\Assets\card.png')">
    <EmbeddedResource Include="Assets\card.png" LogicalName="card.png" />
  </ItemGroup>

  <!-- Every mod DLL lands in one folder. -p:NoDeploy=true skips it (always use it while the game is running). -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(OthGameProject)' == 'true' and '$(NoDeploy)' != 'true' and '$(Loader)' != 'Melon'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\OverTheHillMods" />
  </Target>
  <!-- MelonLoader: the game copy's Mods folder (OTH.Core.dll, OTH.<Name>.dll). -->
  <Target Name="CopyToMelonMods" AfterTargets="Build" Condition="'$(OthGameProject)' == 'true' and '$(NoDeploy)' != 'true' and '$(Loader)' == 'Melon'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MelonGameDir)\Mods" />
  </Target>
  <Target Name="OthMelonOnly" BeforeTargets="Build;CoreCompile" Condition="'$(OthGameProject)' == 'true' and '$(Loader)' == 'Melon' and '$(OthMelon)' != 'true'">
    <Error Text="$(MSBuildProjectName) is BepInEx-only: build the MelonLoader mods with src/MelonCarPack.slnf." />
  </Target>
</Project>
