<Project>
  <!-- Shared settings for every project in this folder. -->
  <PropertyGroup>
    <!-- BepInEx 6 IL2CPP runs plugins on the bundled .NET 6 runtime -->
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\over the hill</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <!-- Projects that must not touch the game (the test project) set OthGameProject=false in their csproj. -->
    <OthGameProject Condition="'$(OthGameProject)' == ''">true</OthGameProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(OthGameProject)' == 'true'">
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <!-- Generated by BepInEx on first game launch -->
    <Reference Include="$(BepInExDir)\interop\*.dll" Private="false" />
  </ItemGroup>

  <!-- A mod's card in the MOD BROWSER (16:9 PNG, 640 x 360): Assets/card.png in the project's folder, embedded as
       "card.png"; core reads it from the DLL that registered the mod (UI/GameMenu/ModImages.cs). -->
  <ItemGroup Condition="'$(OthGameProject)' == 'true' and Exists('$(MSBuildProjectDirectory)\Assets\card.png')">
    <EmbeddedResource Include="Assets\card.png" LogicalName="card.png" />
  </ItemGroup>

  <!-- Every mod DLL lands in one folder. -p:NoDeploy=true skips it (always use it while the game is running). -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(OthGameProject)' == 'true' and '$(NoDeploy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\OverTheHillMods" />
  </Target>
</Project>
