<Project Sdk="Microsoft.NET.Sdk">

  <!-- A tiny example mod for the OTH Mod Manager's public API (docs/modding-api.md).
       Not part of src/OverTheHillMods.sln and never shipped in a release.
       Build: dotnet build examples/HelloMod -c Release -p:GameDir="<your game folder>"
       Add -p:NoDeploy=true to build without copying HelloMod.dll into the game. -->

  <PropertyGroup>
    <!-- BepInEx 6 IL2CPP runs plugins on its bundled .NET 6 runtime -->
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>HelloMod</AssemblyName>
    <RootNamespace>HelloMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\over the hill</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <!-- Generated by BepInEx on the first game launch -->
    <Reference Include="$(BepInExDir)\interop\*.dll" Private="false" />
  </ItemGroup>

  <!-- The Mod Manager. Outside this repository, reference the installed DLL instead:
       <Reference Include="$(BepInExDir)\plugins\OverTheHillMods\OTH.Core.dll" Private="false" /> -->
  <ItemGroup>
    <!-- NoDeploy for core: building the example never copies a core DLL into the game. -->
    <ProjectReference Include="..\..\src\Core\OTH.Core.csproj" Private="false" AdditionalProperties="NoDeploy=true" />
  </ItemGroup>

  <!-- Your mod goes in its own folder under BepInEx/plugins, not in OverTheHillMods (the Mod Manager's own folder). -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(NoDeploy)' != 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\HelloMod" />
  </Target>

</Project>
